# ===========================
#  Fabular — .gitignore
# ===========================

# --- Dependências ---
node_modules/
bower_components/

# --- Variáveis de ambiente / secrets ---
.env
.env.local
.env.*.local

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Build / Output ---
dist/
build/
out/

# --- Editores e IDEs ---
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# --- Sistema Operacional ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# --- Arquivos temporários ---
*.tmp
*.temp
*.swp
*.bak

# --- Cobertura de testes ---
coverage/
.nyc_output/

# --- Cache ---
.cache/
.parcel-cache/
.eslintcache
