# --- Sistema operacional ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
*~

# --- Arquivos temporários ---
*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig

